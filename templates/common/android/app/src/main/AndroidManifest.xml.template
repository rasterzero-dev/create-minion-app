<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Minion App"
        android:theme="@style/MinionSplashTheme"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- OTA metadata is inherited from the Minion library and generated from
             minion.config.json. Explicit application metadata takes precedence:
             Add xmlns:tools="http://schemas.android.com/tools" to manifest, then:
             <meta-data android:name="dev.minion.ota.channel"
                 android:resource="@string/my_ota_channel" tools:replace="android:resource" />
             See docs/ota.md for the signing key and enabled/url configuration. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
        </activity>
    </application>
</manifest>
